  "readJsonl": [
    {
      "name": "result event wins",
      "stdout": "{\"type\":\"system\",\"session_id\":\"abc\"}\n{\"type\":\"assistant\",\"message\":{\"content\":[{\"type\":\"text\",\"text\":\"working\"}]}}\n{\"type\":\"result\",\"result\":\"All done\",\"session_id\":\"abc\"}\n",
      "fields": {},
      "expect": {
        "text": "All done",
        "sessionId": "abc",
        "events": 3
      }
    },
    {
      "name": "configured fields",
      "stdout": "noise line\n{\"data\":{\"answer\":\"42\"},\"meta\":{\"sid\":\"x9\"}}\n",
      "fields": {
        "resultField": "data.answer",
        "sessionIdField": "meta.sid"
      },
      "expect": {
        "text": "42",
        "sessionId": "x9",
        "events": 1
      }
    },
    {
      "name": "no json at all",
      "stdout": "plain text only\n",
      "fields": {},
      "expect": {
        "text": null,
        "sessionId": null,
        "events": 0
      }
    }
  ],
  "screen": [
    {
      "name": "carriage return overwrites a progress line",
      "cols": 40,
      "rows": 5,
      "chunks": [
        "Loading 10%\rLoading 100%\r\nReady\r\n"
      ],
      "expect": "Loading 100%\nReady"
