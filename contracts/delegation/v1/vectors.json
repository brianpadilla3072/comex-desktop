    {
      "name": "colors are dropped",
      "cols": 40,
      "rows": 5,
      "chunks": [
        "\u001b[1;32mOK\u001b[0m done\r\n"
      ],
      "expect": "OK done"
    },
    {
      "name": "cursor positioning draws a box",
      "cols": 20,
      "rows": 4,
      "chunks": [
        "\u001b[2J\u001b[H+--+\u001b[2;1H|hi|\u001b[3;1H+--+"
      ],
      "expect": "+--+\n|hi|\n+--+"
    },
    {
      "name": "erase line and clear screen",
      "cols": 20,
      "rows": 3,
      "chunks": [
        "old text\r\nmore\u001b[2J\u001b[Hnew\u001b[K"
      ],
      "expect": "new"
    },
    {
      "name": "sequence split across chunks",
      "cols": 20,
      "rows": 3,
      "chunks": [
        "\u001b[3",
        "1mred\u001b",
        "[0m text"
      ],
      "expect": "red text"
    },
    {
      "name": "alternate screen starts clean",
      "cols": 20,
      "rows": 3,
      "chunks": [
        "shell$ \u001b[?1049h\u001b[Hmenu\r\n> pick"
      ],
      "expect": "menu\n> pick"
    },
    {
      "name": "long lines wrap",
      "cols": 5,
      "rows": 3,
      "chunks": [
        "abcdefgh"
      ],
      "expect": "abcde\nfgh"
    }
  ],
