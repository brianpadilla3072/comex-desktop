  "renderCommand": [
    {
      "name": "prompt inside an argument",
      "template": [
        "agent",
        "--task={prompt}",
        "-q"
      ],
      "values": {
        "prompt": "fix the bug"
      },
      "expect": [
        "agent",
        "--task=fix the bug",
        "-q"
      ]
    },
    {
      "name": "prompt with quotes and newlines stays one argument",
      "template": [
        "agent",
        "-p",
        "{prompt}"
      ],
      "values": {
        "prompt": "say \"hi\"\nthen $(rm -rf /) `x` ; && |"
      },
      "expect": [
        "agent",
        "-p",
        "say \"hi\"\nthen $(rm -rf /) `x` ; && |"
      ]
    },
    {
      "name": "session and prompt",
      "template": [
        "agent",
        "--resume",
        "{sessionId}",
        "{prompt}"
      ],
      "values": {
        "prompt": "continue",
        "sessionId": "s-123"
      },
      "expect": [
        "agent",
        "--resume",
        "s-123",
        "continue"
      ]
    }
  ],
  "escapeCmdArgument": [
    {
      "arg": "simple",
      "doubleEscape": true,
      "expect": "^^^\"simple^^^\""
    },
    {
      "arg": "two words",
      "doubleEscape": true,
      "expect": "^^^\"two^^^ words^^^\""
    },
    {
      "arg": "a\"quote",
      "doubleEscape": true,
      "expect": "^^^\"a\\^^^\"quote^^^\""
    },
    {
      "arg": "50% & more",
      "doubleEscape": true,
      "expect": "^^^\"50^^^%^^^ ^^^&^^^ more^^^\""
    },
    {
      "arg": "trailing\\",
      "doubleEscape": true,
      "expect": "^^^\"trailing\\\\^^^\""
    },
    {
      "arg": "path\\to\\\"x\"",
      "doubleEscape": true,
      "expect": "^^^\"path\\to\\\\\\^^^\"x\\^^^\"^^^\""
    },
    {
      "arg": "(x)|y^z!",
      "doubleEscape": true,
      "expect": "^^^\"^^^(x^^^)^^^|y^^^^z^^^!^^^\""
    }
  ],
  "planSpawn": [
    {
      "name": "posix executable runs directly",
      "executable": "/usr/local/bin/devin",
      "args": [
        "-p",
        "hello world"
      ],
      "platform": "linux",
      "comspec": "C:\\Windows\\system32\\cmd.exe",
      "expect": {
        "file": "/usr/local/bin/devin",
        "args": [
          "-p",
          "hello world"
        ],
        "windowsVerbatimArguments": false
      }
    },
    {
      "name": "windows exe runs directly",
      "executable": "C:\\Tools\\devin.exe",
      "args": [
        "-p",
        "hello world"
      ],
      "platform": "win32",
      "comspec": "C:\\Windows\\system32\\cmd.exe",
      "expect": {
        "file": "C:\\Tools\\devin.exe",
        "args": [
          "-p",
          "hello world"
        ],
        "windowsVerbatimArguments": false
      }
    },
    {
      "name": "windows cmd shim goes through cmd.exe",
      "executable": "C:\\Users\\a\\AppData\\Roaming\\npm\\agent.cmd",
      "args": [
        "-p",
        "fix & test"
      ],
      "platform": "win32",
      "comspec": "C:\\Windows\\system32\\cmd.exe",
      "expect": {
        "file": "C:\\Windows\\system32\\cmd.exe",
        "args": [
          "/d",
          "/s",
          "/c",
          "\"C:\\Users\\a\\AppData\\Roaming\\npm\\agent.cmd ^^^\"-p^^^\" ^^^\"fix^^^ ^^^&^^^ test^^^\"\""
        ],
        "windowsVerbatimArguments": true
      }
    }
  ],
  "planSpawnErrors": [
    {
      "name": "line break in a cmd shim argument",
